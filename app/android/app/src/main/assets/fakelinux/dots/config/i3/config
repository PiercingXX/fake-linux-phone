# GitHub.com/PiercingXX
# i3 for the phone. Derived from piercing-dots/dots/i3/config: same keys, same
# colors, same gaps. Removed: multi-monitor xrandr, systemd/pipewire/NetworkManager
# daemons, brightness keys and everything that needs hardware a phone doesn't give us.

set $mod Mod4
set $terminal kitty

font pango:JetBrainsMono Nerd Font, JetBrains Mono 10

for_window [class=".*"] border pixel 2
gaps inner 8
gaps outer 10
smart_borders on
focus_follows_mouse yes
floating_modifier $mod

# ── Startup ──
exec_always --no-startup-id setxkbmap -layout us -variant colemak -option caps:backspace
exec_always --no-startup-id xsetroot -cursor_name left_ptr
exec_always --no-startup-id sh -c 'img="$HOME/.config/wall.png"; [ -f "$img" ] || img=$(ls "$HOME"/Pictures/backgrounds/* 2>/dev/null | shuf -n1); [ -n "$img" ] && feh --bg-fill --no-fehbg "$img"'
exec --no-startup-id dunst

# ── Colors (piercing-dots) ──
client.focused          #ffffff #ffffff #000000 #ffffff   #ffffff
client.unfocused        #414141 #414141 #ffffff #414141   #414141
client.focused_inactive #414141 #414141 #ffffff #414141   #414141
client.placeholder      #414141 #414141 #ffffff #414141   #414141
client.urgent           #ff6767 #ff6767 #ffffff #ff6767   #ff6767
client.background       #000000

# ── Bar ──
bar {
    position top
    status_command i3status -c ~/.config/i3status/config
    colors {
        background #000000
        statusline #ffffff
        separator  #414141
        focused_workspace  #ffffff #ffffff #000000
        active_workspace   #414141 #414141 #ffffff
        inactive_workspace #000000 #000000 #8a8a8a
        urgent_workspace   #ff6767 #ff6767 #ffffff
    }
}

# ── Apps ──
bindsym $mod+w exec kitty
bindsym $mod+t exec kitty tmux
bindsym $mod+z exec kitty yazi
bindsym $mod+v exec kitty nvim
bindsym $mod+c exec firefox
bindsym $mod+space exec bash ~/.scripts/Control-Scripts/wm-app-launcher.sh
bindsym Mod1+Tab exec bash ~/.scripts/Control-Scripts/wm-app-launcher.sh
bindsym $mod+s exec bash ~/.scripts/phone-menu.sh
bindsym $mod+slash exec xdg-open "$HOME/.scripts/Control-Scripts/keybinds.html"

# ── Screenshots ──
bindsym Print exec bash ~/.scripts/screenshot.sh select
bindsym Shift+Print exec bash ~/.scripts/screenshot.sh window
bindsym $mod+Print exec bash ~/.scripts/screenshot.sh full

# ── Volume ──
bindsym $mod+Up exec bash ~/.scripts/volume.sh inc
bindsym $mod+Down exec bash ~/.scripts/volume.sh dec
bindsym $mod+Control+m exec bash ~/.scripts/volume.sh mute
bindsym XF86AudioRaiseVolume exec bash ~/.scripts/volume.sh inc
bindsym XF86AudioLowerVolume exec bash ~/.scripts/volume.sh dec
bindsym XF86AudioMute exec bash ~/.scripts/volume.sh mute

# ── Windows ──
bindsym $mod+q kill
bindsym $mod+x layout toggle split
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+f floating toggle
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3 and close the desktop?' -B 'Yes, exit' 'i3-msg exit'"

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Mod1+h resize shrink width 100 px or 5 ppt
bindsym $mod+Mod1+j resize grow height 100 px or 5 ppt
bindsym $mod+Mod1+k resize shrink height 100 px or 5 ppt
bindsym $mod+Mod1+l resize grow width 100 px or 5 ppt

# ── Workspaces ──
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1; workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2; workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3; workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4; workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5; workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6; workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7; workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8; workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9; workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10; workspace $ws10

mode "resize" {
    bindsym Left  resize shrink width 10 px or 5 ppt
    bindsym Down  resize grow height 10 px or 5 ppt
    bindsym Up    resize shrink height 10 px or 5 ppt
    bindsym Right resize grow width 10 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"
